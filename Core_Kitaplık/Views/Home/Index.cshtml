@model List<Core_Kitaplık.Models.Kitap>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Kitapadi</th>
        <th>Yazar</th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.KitapAd</td>
            <td>@item.Yazar</td>
        </tr>
    }
</table>


